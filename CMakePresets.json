{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "NEOWPF_RENDERER_BACKEND": "Vulkan"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "android-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_ANDROID_API": "24",
                "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "NEOWPF_RENDERER_BACKEND": "Vulkan"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "NeoWPF x64 Debug",
            "inherits": "windows-base"
        },
        {
            "name": "x64-release",
            "displayName": "NeoWPF x64 Release",
            "inherits": "windows-base"
        },
        {
            "name": "linux-debug",
            "displayName": "NeoWPF Linux Debug",
            "inherits": "linux-base"
        },
        {
            "name": "linux-release",
            "displayName": "NeoWPF Linux Release",
            "inherits": "linux-base"
        },
        {
            "name": "android-debug",
            "displayName": "NeoWPF Android Debug",
            "inherits": "android-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "android-release",
            "displayName": "NeoWPF Android Release",
            "inherits": "android-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release",
            "configuration": "Release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "configuration": "Release"
        },
        {
            "name": "android-debug",
            "configurePreset": "android-debug",
            "configuration": "Debug"
        },
        {
            "name": "android-release",
            "configurePreset": "android-release",
            "configuration": "Release"
        }
    ]
}
