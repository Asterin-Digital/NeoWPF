{
  "rules": {
    "neowpf-property-source-tag": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-documentation-coverage": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-documentation-tags": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-dp-registration-location": {
      "enabled": true,
      "severity": "error",
      "paths": {
        "*include/NeoWPF/UI/Properties/DependencyProperty.h": {
          "enabled": false
        },
        "*include/NeoWPF/UI/Properties/Registration/DependencyPropertyRegistration.h": {
          "enabled": false
        }
      }
    },
    "neowpf-source-layout": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-forbidden-namespace": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-virtual-destructor": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-platform-utility-duplicate": {
      "enabled": true,
      "severity": "error"
    },
    "neowpf-platform-dependency-isolation": {
      "enabled": true,
      "severity": "error",
      "options": {
        "platforms": ["windows", "linux", "android"],
        "path_platforms": {
          "*Platform/Windows/*": "windows",
          "*Platform/Linux/*": "linux",
          "*Platform/Android/*": "android",
          "*Platform/Posix/*": "linux,android"
        }
      },
      "paths": {
        "*src/Platform/PlatformRegistry.cpp": {
          "enabled": false
        }
      }
    },
    "neowpf-platform-code-location": {
      "enabled": true,
      "severity": "error",
      "options": {
        "platform_macros": {
          "_WIN32": "windows",
          "_WIN64": "windows",
          "__linux__": "linux",
          "__ANDROID__": "android"
        }
      }
    }
  }
}
