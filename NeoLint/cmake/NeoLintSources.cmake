file(GLOB_RECURSE NEOLINT_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp"
)

file(GLOB_RECURSE NEOLINT_HEADERS CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/include/*.h"
)

set(NEOLINT_TEST_SOURCES ${NEOLINT_SOURCES})
list(FILTER NEOLINT_TEST_SOURCES EXCLUDE REGEX "[/\\\\]Driver[/\\\\]Main\\.cpp$")
file(GLOB_RECURSE NEOLINT_TEST_FILES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/tests/*.cpp"
)
list(APPEND NEOLINT_TEST_SOURCES ${NEOLINT_TEST_FILES})

set(NEOLINT_SOURCES ${NEOLINT_SOURCES} ${NEOLINT_HEADERS})