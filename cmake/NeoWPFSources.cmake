file(GLOB_RECURSE NEOWPF_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp"
)

file(GLOB_RECURSE NEOWPF_BACKEND_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/Rendering/${NEOWPF_RENDERER_BACKEND}/*.cpp"
)

if(NOT NEOWPF_BACKEND_SOURCES)
    message(FATAL_ERROR
        "No sources found for NEOWPF_RENDERER_BACKEND='${NEOWPF_RENDERER_BACKEND}'.")
endif()

list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/Rendering/(D3D11|Vulkan)/")
list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/NeoNaml/")
list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/Media/")
list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/DotNet/")
if(NOT WIN32)
    list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/Platform/Windows/")
else()
    list(FILTER NEOWPF_SOURCES EXCLUDE REGEX "/src/Platform/Linux/")
endif()
list(APPEND NEOWPF_SOURCES ${NEOWPF_BACKEND_SOURCES})

file(GLOB_RECURSE NEOWPF_MEDIA_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/Media/*.cpp"
)

file(GLOB_RECURSE NEOWPF_MEDIA_HEADERS CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/Media/*.h"
)

if(NOT NEOWPF_MEDIA_SOURCES)
    message(FATAL_ERROR
        "No sources found under ${CMAKE_CURRENT_SOURCE_DIR}/src/Media for NeoWPF.Media.")
endif()

file(GLOB_RECURSE NEOWPF_HEADERS
    "${CMAKE_CURRENT_SOURCE_DIR}/include/NeoWPF/*.h"
    "${CMAKE_CURRENT_SOURCE_DIR}/include/NeoNaml/*.h"
)
list(FILTER NEOWPF_HEADERS EXCLUDE REGEX "/include/NeoWPF/DotNet/")

set(NEOWPF_DOTNET_SOURCES)
set(NEOWPF_DOTNET_HEADERS)
if(NEOWPF_BUILD_DOTNET)
    file(GLOB_RECURSE NEOWPF_DOTNET_SOURCES CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/src/DotNet/*.cpp"
    )
    file(GLOB_RECURSE NEOWPF_DOTNET_HEADERS CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/include/NeoWPF/DotNet/*.h"
    )
    if(NOT WIN32)
        list(FILTER NEOWPF_DOTNET_SOURCES EXCLUDE REGEX "/src/DotNet/([^/]+/)*Windows/")
    else()
        list(FILTER NEOWPF_DOTNET_SOURCES EXCLUDE REGEX "/src/DotNet/([^/]+/)*Linux/")
    endif()
    if(NOT NEOWPF_DOTNET_SOURCES)
        message(FATAL_ERROR
            "NEOWPF_BUILD_DOTNET is enabled, but no sources were found under "
            "${CMAKE_CURRENT_SOURCE_DIR}/src/DotNet.")
    endif()
endif()
